generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Post {
  id            String   @id @default(cuid())
  slug          String   @unique @db.VarChar(160)
  title         String   @db.VarChar(120)
  category      String   @db.VarChar(80)
  publishedAt   DateTime
  excerpt       String   @db.VarChar(250)
  author        String   @db.VarChar(160)
  bodyHtml      String   @db.LongText
  status        String   @default("draft") @db.VarChar(20)
  seoTitle      String?  @db.VarChar(60)
  seoDescription String? @db.VarChar(160)
  imagePath     String?  @db.VarChar(500)
  imageCardPath String?  @db.VarChar(500)
  imageAlt      String?  @db.VarChar(180)
  imageCaption  String?  @db.VarChar(255)
  galleryJson   String?  @db.LongText
  noIndex       Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status, publishedAt])
  @@index([category])
  @@map("posts")
}

model SiteSettings {
  id                Int      @id @default(1)
  siteName          String   @default("Grupo Mais Barato") @db.VarChar(120)
  defaultTitle      String   @db.VarChar(70)
  defaultDescription String  @db.VarChar(180)
  defaultKeywords   Json
  googleAnalyticsId String?  @db.VarChar(30)
  canonicalUrl      String?  @db.VarChar(255)
  ogImage           String?  @db.VarChar(500)
  robotsIndex       Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("site_settings")
}
